{
  "$schema": "https://w3id.org/osd/0.6/device.schema.json",
  "_sources": [
    {
      "type": "vendor-doc",
      "firmware": "2.10",
      "notes": "The controls of the Korg minilogue that its MIDI implementation gives a CC number, each with the role that says what it does: the roles are written by OSD, the numbers are the maker's. The EG is the envelope of the filter when its target is the cutoff."
    }
  ],
  "role_vocabulary": "1",
  "device": { "name": "minilogue", "vendor": "Korg", "osc_prefix": "/minilogue" },
  "cc_params": {
    "channel": 0,
    "entries": [
      { "osc": "/amp/env/attack", "cc": 16, "role": { "parts": [{ "part": "amplifier" }, { "part": "envelope" }], "setting": "attack-time" } },
      { "osc": "/amp/env/decay", "cc": 17, "role": { "parts": [{ "part": "amplifier" }, { "part": "envelope" }], "setting": "decay-time" } },
      { "osc": "/amp/env/sustain", "cc": 18, "role": { "parts": [{ "part": "amplifier" }, { "part": "envelope" }], "setting": "sustain-level" } },
      { "osc": "/amp/env/release", "cc": 19, "role": { "parts": [{ "part": "amplifier" }, { "part": "envelope" }], "setting": "release-time" } },
      { "osc": "/eg/attack", "cc": 20, "role": { "parts": [{ "part": "filter" }, { "part": "envelope" }], "setting": "attack-time" } },
      { "osc": "/eg/decay", "cc": 21, "role": { "parts": [{ "part": "filter" }, { "part": "envelope" }], "setting": "decay-time" } },
      { "osc": "/lfo/rate", "cc": 24, "role": { "parts": [{ "part": "lfo" }], "setting": "rate" } },
      { "osc": "/delay/time", "cc": 31, "role": { "parts": [{ "part": "delay" }], "setting": "delay-time" } },
      { "osc": "/vco1/pitch", "cc": 34, "role": { "parts": [{ "part": "oscillator", "index": 1 }], "setting": "pitch" } },
      { "osc": "/vco2/pitch", "cc": 36, "role": { "parts": [{ "part": "oscillator", "index": 2 }], "setting": "pitch" } },
      { "osc": "/vco1/level", "cc": 39, "role": { "parts": [{ "part": "oscillator", "index": 1 }], "setting": "level" } },
      { "osc": "/filter/cutoff", "cc": 43, "role": { "parts": [{ "part": "filter" }], "setting": "cutoff" } },
      { "osc": "/filter/resonance", "cc": 44, "role": { "parts": [{ "part": "filter" }], "setting": "resonance" } },
      { "osc": "/voice/portamento", "cc": 5, "role": { "parts": [{ "part": "voice" }], "setting": "portamento-time" } }
    ]
