{
  "_about": "A device says how a file is written on it by MIDI: the Deluge opens the file by a JSON command and keeps the file id of its reply (capture_json), writes it in chunks of at most 1024 bytes (coding msb_first_7in8, the name of the packing of sound_transfers), then closes it. The variable parts are objects the schema checks (file, captured), never a template in a string.",
  "_note": "Built from the code of the community firmware (DelugeFirmware 680b93c, GPL-3.0-only), not observed on a device. The wait for a reply, 1000 ms, is a choice of OSD.",
  "read": "device",
  "result": {
    "$schema": "https://w3id.org/osd/0.6/device.schema.json",
    "device": {
      "name": "Deluge",
      "vendor": "Synthstrom Audible",
      "osc_prefix": "/deluge"
    },
    "resources": [
      {
        "resource": "X-DeviceDefinition",
        "canSet": "full",
        "mediaTypes": [
          "application/xml"
        ],
        "export": "deluge",
        "via": {
          "file_write": {
            "path": [
              "MIDI_DEVICES",
              "DEFINITION",
              {
                "variable": "vendor"
              },
              {
                "variable": "device",
                "suffix": ".xml"
              }
            ],
            "carried_by": "sysex",
            "steps": [
              {
                "step": "open",
                "send": [
                  240,
                  0,
                  33,
                  123,
                  1,
                  4,
                  0,
                  {
                    "text": "{\"open\":{\"path\":\""
                  },
                  {
                    "file": "path"
                  },
                  {
                    "text": "\",\"write\":1}}"
                  },
                  247
                ],
                "reply": [
                  240,
                  0,
                  33,
                  123,
                  1,
                  5,
                  "any",
                  {
                    "capture_json": "fid"
                  }
                ],
                "reply_timeout_ms": 1000
              },
              {
                "step": "write",
                "chunk_bytes": 1024,
                "coding": "msb_first_7in8",
                "send": [
                  240,
                  0,
                  33,
                  123,
                  1,
                  4,
                  0,
                  {
                    "text": "{\"write\":{\"fid\":"
                  },
                  {
                    "captured": "fid",
                    "as": "decimal"
                  },
                  {
                    "text": ",\"addr\":"
                  },
                  {
                    "file": "offset",
                    "as": "decimal"
                  },
                  {
                    "text": ",\"size\":"
                  },
                  {
                    "file": "chunk_size",
                    "as": "decimal"
                  },
                  {
                    "text": "}}"
                  },
                  0,
                  {
                    "file": "chunk"
                  },
                  247
                ],
                "reply": [
                  240,
                  0,
                  33,
                  123,
                  1,
                  5,
                  "any"
                ],
                "reply_timeout_ms": 1000
              },
              {
                "step": "close",
                "send": [
                  240,
                  0,
                  33,
                  123,
                  1,
                  4,
                  0,
                  {
                    "text": "{\"close\":{\"fid\":"
                  },
                  {
                    "captured": "fid",
                    "as": "decimal"
                  },
                  {
                    "text": "}}"
                  },
                  247
                ],
                "reply": [
                  240,
                  0,
                  33,
                  123,
                  1,
                  5,
                  "any"
                ],
                "reply_timeout_ms": 1000
              }
            ]
          }
        }
      }
    ],
    "_sources": [
      {
        "type": "community-re",
        "url": "https://github.com/SynthstromAudible/DelugeFirmware",
        "firmware": "community 1.3",
        "commit": "680b93c",
        "license": "GPL-3.0-only",
        "notes": "The community firmware reads and writes the files of its card by SysEx in JSON commands (sysex/smsysex.cpp, 1024-byte buffers, identity 00 21 7B, family 01). The messages here are built from that code, not observed on a device; the 1000 ms wait for a reply is a choice of OSD, the firmware gives none."
      }
    ]
  }
}
