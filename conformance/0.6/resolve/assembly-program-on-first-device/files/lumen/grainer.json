  "name": "Grainer",
  "version": "1.2",
  "kind": "application",
  "targets": [
    {
      "device": {"descriptor": "kestrel/pocket-one", "vendor": "Kestrel", "model": "Pocket One"},
      "midi": {"descriptor": "lumen/grainer-midi"},
