{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/osd/0.5/device.schema.json",
  "title": "OSD device descriptor 0.5",
  "description": "How a synthesizer, drum machine, controller or music software speaks MIDI or OSC: its identity, controls, messages, programs and drum sounds, with where each piece of data comes from. One file per device and source; a firmware with its own MIDI is its own file. Fields starting with _ are notes for people.",
  "type": "object",
  "required": [
    "$schema",
    "device"
  ],
  "patternProperties": {
    "^_": {
      "description": "A note for people (provenance, caveats, usage); never read by a program."
    }
  },
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "const": "https://w3id.org/osd/0.5/device.schema.json"
    },
    "device": {
      "$ref": "#/$defs/device"
    },
    "midi_of": {
      "type": "string",
      "description": "The descriptor whose MIDI this firmware answers to unchanged (its id, maker/file without .json): this file then only says what differs."
    },
    "loads_sounds_of": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Devices (their address prefix without /) whose sounds this one loads as they are."
    },
    "identity": {
      "$ref": "#/$defs/identity"
    },
    "programs": {
      "$ref": "#/$defs/programs"
    },
    "sysex": {
      "type": "object",
      "properties": {
        "header": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        },
        "footer": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        }
      },
      "patternProperties": {
        "^_": {
          "description": "A note for people (provenance, caveats, usage); never read by a program."
        }
      },
      "additionalProperties": false,
      "description": "The bytes every SysEx message of the device starts and ends with."
    },
    "cc_params": {
      "type": "object",
      "properties": {
        "channel": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15,
          "description": "MIDI channel, 0-15 (channel 1 is 0)."
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/cc_entry"
          }
        }
      },
      "patternProperties": {
        "^_": {
          "description": "A note for people (provenance, caveats, usage); never read by a program."
        }
      },
      "additionalProperties": false,
      "required": [
        "entries"
      ],
      "description": "Controls set by Control Change, 14-bit CC pairs, NRPN or RPN."
    },
    "params": {
      "type": "object",
      "properties": {
        "get_frame": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/frame_token"
          },
          "description": "A message, byte by byte."
        },
        "set_frame": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/frame_token"
          },
          "description": "A message, byte by byte."
        },
        "value_type": {
          "enum": [
            "u7",
            "u14",
            "s32"
          ]
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/param_entry"
          }
        }
      },
      "patternProperties": {
        "^_": {
          "description": "A note for people (provenance, caveats, usage); never read by a program."
        }
      },
      "additionalProperties": false,
      "required": [
        "get_frame",
        "set_frame",
        "value_type",
        "entries"
      ],
      "description": "Parameters read and written by SysEx through one shared message shape."
    },
    "commands": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/command"
      },
      "description": "Named messages: SysEx utilities, or OSC messages of a software."
    },
    "triggers": {
      "type": "object",
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/trigger"
          }
        }
      },
      "patternProperties": {
        "^_": {
          "description": "A note for people (provenance, caveats, usage); never read by a program."
        }
      },
      "additionalProperties": false,
      "required": [
        "entries"
      ],
      "description": "Drum and sample sounds fired by a note."
    },
    "midi_out": {
      "type": "object",
      "properties": {
        "default_channel": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15,
          "description": "MIDI channel, 0-15 (channel 1 is 0)."
        },
        "note_offset": {
          "type": "integer",
          "description": "Added to every note number sent."
        }
      },
      "patternProperties": {
        "^_": {
          "description": "A note for people (provenance, caveats, usage); never read by a program."
        }
      },
      "additionalProperties": false,
      "description": "Playing it: notes, pitch bend, aftertouch, program change."
    },
    "midi_in": {
      "type": "object",
      "properties": {
        "note_on": {
          "type": "string",
          "description": "osc-bridge extension: the address a received note on is reported at.",
          "x-osd-extension": "osc-bridge"
        },
        "note_off": {
          "type": "string",
          "description": "osc-bridge extension: the address a received note off is reported at.",
          "x-osd-extension": "osc-bridge"
        },
        "cc": {
          "type": "string",
          "description": "osc-bridge extension: the address a received cc is reported at.",
          "x-osd-extension": "osc-bridge"
        },
        "pitchbend": {
          "type": "string",
          "description": "osc-bridge extension: the address a received pitchbend is reported at.",
          "x-osd-extension": "osc-bridge"
        },
        "aftertouch": {
          "type": "string",
          "description": "osc-bridge extension: the address a received aftertouch is reported at.",
          "x-osd-extension": "osc-bridge"
        },
        "poly_aftertouch": {
          "type": "string",
          "description": "osc-bridge extension: the address a received poly aftertouch is reported at.",
          "x-osd-extension": "osc-bridge"
        },
        "program_change": {
          "type": "string",
          "description": "osc-bridge extension: the address a received program change is reported at.",
          "x-osd-extension": "osc-bridge"
        }
      },
      "patternProperties": {
        "^_": {
          "description": "A note for people (provenance, caveats, usage); never read by a program."
        }
      },
      "additionalProperties": false,
      "description": "What the device sends while played, and how it is reported."
    },
    "replies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reply"
      },
      "description": "Messages the device answers or sends by itself, recognised."
    },
    "subscriptions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "on": {
            "enum": [
              "startup"
            ]
          },
          "forward": {
            "$ref": "#/$defs/forward"
          }
        },
        "patternProperties": {
          "^_": {
            "description": "A note for people (provenance, caveats, usage); never read by a program."
          }
        },
        "additionalProperties": false,
        "required": [
          "forward"
        ]
      },
      "description": "OSC messages a software needs at start to report its changes."
    },
    "custom_commands": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "osc": {
            "type": "string",
            "pattern": "^/",
            "description": "The control's address, read the same way from one device to the next (/filter/cutoff), after the device's prefix."
          },
          "script": {
            "type": "string",
            "description": "osc-bridge extension: a Lua script that builds the message.",
            "x-osd-extension": "osc-bridge"
          },
          "profile": {
            "enum": [
              "default",
              "preset_ingest"
            ]
          },
          "wrap_sysex": {
            "type": "boolean"
          }
        },
        "patternProperties": {
          "^_": {
            "description": "A note for people (provenance, caveats, usage); never read by a program."
          }
        },
        "additionalProperties": false,
        "required": [
          "osc",
          "script"
        ]
      },
      "x-osd-extension": "osc-bridge",
      "description": "osc-bridge extension: addresses handled by a script only."
    },
    "_sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      },
      "description": "Where the data comes from, with its credit, licence and the firmware it documents."
    },
    "_coverage": {
      "type": "object",
      "description": "What the source covers, counted.",
      "additionalProperties": true
    }
  },
  "$defs": {
    "frame_part": {
      "description": "An element of a frame that is not a byte: an object of one key of its nature, with the keys that qualify it.",
      "oneOf": [
        {
          "title": "arg",
          "description": "An argument of the command, with its encoding, or an offset added to a 7-bit argument (the sum wraps on 7 bits).",
          "type": "object",
          "required": ["arg"],
          "additionalProperties": false,
          "properties": {
            "arg": { "type": "string" },
            "encoding": { "enum": ["u14_msb", "u14_lsb", "s32", "ascii", "bytes"] }
          }
        },
        {
          "title": "arg with an added offset",
          "type": "object",
          "required": ["arg", "add"],
          "additionalProperties": false,
          "properties": {
            "arg": { "type": "string" },
            "add": { "type": "integer", "minimum": 0, "maximum": 127 }
          }
        },
        {
          "title": "device_id",
          "description": "The device id, by the rule of identity.device_id with its default value.",
          "type": "object",
          "required": ["device_id"],
          "additionalProperties": false,
          "properties": {
            "device_id": { "const": true }
          }
        },
        {
          "title": "identity",
          "description": "The bytes of the model's family or member: all of them, or the one at index.",
          "type": "object",
          "required": ["identity"],
          "additionalProperties": false,
          "properties": {
            "identity": { "enum": ["family", "member"] },
            "index": { "type": "integer", "minimum": 0, "maximum": 255 }
          }
        },
        {
          "title": "checksum",
          "description": "The checksum of the bytes written from offset from (F0 is 0), on length bytes when given: twos7 is Roland's two's complement, sum7 Waldorf's sum, xor7 Fractal's xor, each on 7 bits.",
          "type": "object",
          "required": ["checksum", "from"],
          "additionalProperties": false,
          "properties": {
            "checksum": { "enum": ["twos7", "sum7", "xor7"] },
            "from": { "type": "integer", "minimum": 0, "maximum": 65535 },
            "length": { "type": "integer", "minimum": 1, "maximum": 65535 }
          }
        }
      ]
    },
    "frame_token": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        {
          "$ref": "#/$defs/frame_part"
        }
      ],
      "description": "An element of a message sent: a byte, or an object of one key of its nature (arg, device_id, identity, checksum)."
    },
    "recognised_frame_token": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        {
          "const": "any"
        },
        {
          "type": "object",
          "title": "capture",
          "description": "Where a recognised message is read: the value is kept under this name.",
          "required": ["capture"],
          "additionalProperties": false,
          "properties": {
            "capture": { "type": "string" }
          }
        },
        {
          "$ref": "#/$defs/frame_part"
        }
      ],
      "description": "An element of a message recognised: a byte, the word any (any byte), a capture, or an object of one key of its nature (arg, device_id, identity, checksum)."
    },
    "expr": {
      "description": "A value computed from the arguments, a byte of MIDI data from 0 to 127 as the engine bounds it: add, sub and mul give their result bounded to 0..127; gt, lt, eq and ne give 0 or 1; if gives its second operand when the first is not 0, else its third.",
      "oneOf": [
        { "type": "integer", "minimum": 0, "maximum": 127 },
        {
          "title": "arg",
          "type": "object",
          "required": ["arg"],
          "additionalProperties": false,
          "properties": { "arg": { "type": "string" } }
        },
        { "$ref": "#/$defs/expr_op" }
      ]
    },
    "expr_op": {
      "oneOf": [
        { "$ref": "#/$defs/expr_binary_add" },
        { "$ref": "#/$defs/expr_binary_sub" },
        { "$ref": "#/$defs/expr_binary_mul" },
        { "$ref": "#/$defs/expr_binary_gt" },
        { "$ref": "#/$defs/expr_binary_lt" },
        { "$ref": "#/$defs/expr_binary_eq" },
        { "$ref": "#/$defs/expr_binary_ne" },
        {
          "title": "if",
          "type": "object",
          "required": ["if"],
          "additionalProperties": false,
          "properties": {
            "if": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": { "$ref": "#/$defs/expr" }
            }
          }
        }
      ]
    },
    "expr_binary_add": { "type": "object", "required": ["add"], "additionalProperties": false, "properties": { "add": { "$ref": "#/$defs/expr_pair" } } },
    "expr_binary_sub": { "type": "object", "required": ["sub"], "additionalProperties": false, "properties": { "sub": { "$ref": "#/$defs/expr_pair" } } },
    "expr_binary_mul": { "type": "object", "required": ["mul"], "additionalProperties": false, "properties": { "mul": { "$ref": "#/$defs/expr_pair" } } },
    "expr_binary_gt": { "type": "object", "required": ["gt"], "additionalProperties": false, "properties": { "gt": { "$ref": "#/$defs/expr_pair" } } },
    "expr_binary_lt": { "type": "object", "required": ["lt"], "additionalProperties": false, "properties": { "lt": { "$ref": "#/$defs/expr_pair" } } },
    "expr_binary_eq": { "type": "object", "required": ["eq"], "additionalProperties": false, "properties": { "eq": { "$ref": "#/$defs/expr_pair" } } },
    "expr_binary_ne": { "type": "object", "required": ["ne"], "additionalProperties": false, "properties": { "ne": { "$ref": "#/$defs/expr_pair" } } },
    "expr_pair": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "$ref": "#/$defs/expr" }
    },
    "device": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "The model's name, as its maker writes it."
        },
        "vendor": {
          "type": "string"
        },
        "revision": {
          "type": "string",
          "description": "The version this file describes (firmware or document)."
        },
        "osc_prefix": {
          "type": "string",
          "pattern": "^/",
          "description": "The device's own address prefix (/minilogue)."
        },
        "manufacturer_id": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 127
          },
          "description": "The maker's SysEx id: one byte, or three starting with 0."
        },
        "device_id": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 127
          }
        },
        "rate_limit_hz": {
          "type": "integer",
          "minimum": 0,
          "description": "Most messages a second the device takes; 0: no limit known."
        },
        "kind": {
          "enum": [
            "hardware",
            "software"
          ]
        },
        "transport": {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "midi",
                "osc"
              ]
            },
            "host": {
              "type": "string"
            },
            "port": {
              "type": "integer"
            },
            "reply_port": {
              "type": "integer"
            },
            "rate_limit_hz": {
              "type": "integer"
            },
            "passthrough_prefix": {
              "type": "string"
            }
          },
          "patternProperties": {
            "^_": {
              "description": "A note for people (provenance, caveats, usage); never read by a program."
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "description": "How a software is reached (OSC host and ports)."
        }
      },
      "patternProperties": {
        "^_": {
          "description": "A note for people (provenance, caveats, usage); never read by a program."
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "osc_prefix"
      ]
    },
    "identity": {
      "type": "object",
      "properties": {
        "profile": {
          "type": "string",
          "description": "A maker profile this extends (maker or maker/family)."
        },
        "request": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/frame_token"
          },
          "description": "The identify request, when not the Universal Identity Request (F0 7E 7F 06 01 F7); its elements may take the device's own values (an identity object)."
        },
        "unpack": {
          "enum": [
            "lsb_8to7"
          ]
        },
        "reply": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/recognised_frame_token"
          },
          "description": "The start of the reply, element by element: a byte, any, a capture, or an object of its nature."
        },
        "reply_text": {
          "type": "string"
        },
        "family": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        },
        "member": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        },
        "device_id": {
          "type": "object",
          "properties": {
            "default": {
              "type": "integer"
            },
            "min": {
              "type": "integer"
            },
            "max": {
              "type": "integer"
            }
          },
          "patternProperties": {
            "^_": {
              "description": "A note for people (provenance, caveats, usage); never read by a program."
            }
          },
          "additionalProperties": false
        },
        "firmware": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "decode": {
                  "type": "string",
                  "description": "How the bytes read as a version: raw_bytes, yamaha_tenths, korg_minor_major, ascii, json…"
                },
                "at": {
                  "type": "array",
                  "items": {
                    "type": "integer"
                  }
                },
                "field": {
                  "type": "string",
                  "description": "With decode json: the reply from the offset in at to F7 is a JSON object, and the version is this key's text."
                }
              },
              "patternProperties": {
                "^_": {
                  "description": "A note for people (provenance, caveats, usage); never read by a program."
                }
              },
              "additionalProperties": false,
              "required": [
                "decode",
                "at"
              ]
            }
          ],
          "description": "Where the reply carries the firmware version, and how to read it."
        },
        "ports": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Its port names, for a device that does not answer."
        },
        "usb": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/usb_id"
          },
          "description": "Its USB identities (one per model version or mode): the strongest sign of which model is plugged in, read by a native program (a web browser does not see it)."
        },
        "sends": {
          "$ref": "#/$defs/sends"
        }
      },
      "patternProperties": {
        "^_": {
          "description": "A note for people (provenance, caveats, usage); never read by a program."
        }
      },
      "additionalProperties": false,
      "description": "How to recognise the device and its firmware: its answer to an identify request, its port names, its USB identity, what it sends by itself. The controls it sends when its knobs are turned are its cc_params and params."
    },
    "bank": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "msb": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127
        },
        "lsb": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127
        },
        "size": {
          "type": "integer",
          "minimum": 1
        },
        "first_pc": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127
        },
        "first_number": {
          "type": "integer"
        },
        "display": {
          "type": "string",
          "description": "How the device numbers it (A01-H16)."
        },
        "channel": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15,
          "description": "MIDI channel, 0-15 (channel 1 is 0)."
        },
        "selects": {
          "type": "string"
        }
      },
      "patternProperties": {
        "^_": {
          "description": "A note for people (provenance, caveats, usage); never read by a program."
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "size"
      ]
    },
    "programs": {
      "type": "object",
      "properties": {
        "profile": {
          "type": "string"
        },
        "selects": {
          "type": "string",
          "description": "What a program change selects (sound, pattern, kit…)."
        },
        "program_change": {
          "type": "boolean"
        },
        "requires": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Settings on the device needed first, as its manual names them."
        },
        "banks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/bank"
          }
        },
        "before": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/frame_token"
            },
            "description": "A message, byte by byte."
          },
          "description": "Messages sent before a recall."
        },
        "delay_ms": {
          "type": "integer",
          "minimum": 0
        },
        "dump": {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "none",
                "request",
                "edit_buffer",
                "manual"
              ]
            },
            "request": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/frame_token"
              },
              "description": "A message, byte by byte."
            }
          },
          "patternProperties": {
            "^_": {
              "description": "A note for people (provenance, caveats, usage); never read by a program."
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "description": "How the current sound is taken from it."
        },
        "notes": {
          "type": "string"
        }
      },
      "patternProperties": {
        "^_": {
          "description": "A note for people (provenance, caveats, usage); never read by a program."
        }
      },
      "additionalProperties": false,
      "description": "Its programs and banks: how to select one, how they are numbered, how a sound is taken from it."
    },
    "cc_entry": {
      "type": "object",
      "properties": {
        "osc": {
          "type": "string",
          "pattern": "^/",
          "description": "The control's address, read the same way from one device to the next (/filter/cutoff), after the device's prefix."
        },
        "cc": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127
        },
        "cc_lsb": {
          "type": "integer",
